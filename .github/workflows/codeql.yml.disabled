# DISABLED: not picked up by GitHub Actions as-is (needs the .yml/.yaml
# extension directly in .github/workflows/ to run).
#
# CodeQL/code scanning requires GitHub Advanced Security on a private
# repository, which isn't purchased for this account -- confirmed via
# `gh api -X PATCH repos/<owner>/<repo> -f
# security_and_analysis[advanced_security][status]=enabled` returning
# "Advanced security has not been purchased." (422). It's free on public
# repos with no config change needed.
#
# To re-enable once this repo is public: `git mv codeql.yml.disabled
# codeql.yml`.
name: CodeQL

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    - cron: "0 6 * * 1" # weekly, Monday 06:00 UTC

permissions:
  contents: read
  security-events: write
  actions: read # required by codeql-action/analyze to fetch workflow-run
                # status for its SARIF category/telemetry step -- without
                # it, analyze fails late with "Resource not accessible by
                # integration" even though the scan itself completed fine

jobs:
  analyze:
    name: analyze (go)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: github/codeql-action/init@v3
        with:
          languages: go

      - uses: github/codeql-action/autobuild@v3

      - uses: github/codeql-action/analyze@v3
