flowchart TD
    accTitle: Job admission control
    accDescr: Idempotency-key replay, trigger rate limit, parameter validation, exclusive lock, shutdown check, slot cap and the accepted audit write that gate a trigger.
    A["Trigger with action, identity, params"] --> K{{"Idempotency-Key already used within the window? (only if sent)"}}
    K -- "no" --> R{{"Identity under its trigger rate limit? (only if configured)"}}
    K --> P{{"Key seen before: same parameters as the first request?"}}
    P --> E6["Same: 202 with the original job, nothing started"]
    P --> E7["Different: 422"]
    R --> E0["Over the limit: 429 with Retry-After"]
    R -- "yes" --> B{{"Parameters declared and matching patterns?"}}
    B -- "no" --> E1["400"]
    B -- "yes" --> C{{"Action is exclusive?"}}
    C -- "yes" --> D{{"Per-action lock free?"}}
    D -- "no" --> E2["409 busy"]
    D -- "yes" --> F
    C -- "no" --> F{{"Agent stopping?"}}
    F -- "yes" --> E3["503"]
    F -- "no" --> G{{"Slots free, below max_concurrent?"}}
    G -- "no" --> E4["429 with Retry-After"]
    G -- "yes" --> H["Create the job as queued and store it"]
    H --> I{{"accepted audit written and forwarded?"}}
    I -- "no" --> E5["Remove job, release slot and lock, answer 500"]
    I -- "yes" --> J["Start run in a goroutine, answer 202"]
